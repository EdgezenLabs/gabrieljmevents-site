---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gabriel JM Events — Event Management in Chennai</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>

  <body class="bg-white text-gray-900 flex flex-col min-h-screen">

    <!-- Header -->
    <Header />

    <!-- HERO SECTION -->
    <section class="relative w-full h-[70vh] md:h-[80vh] overflow-hidden">

      <picture>
        <!-- Mobile -->
        <source srcset="/assets/hero-mobile.webp" media="(max-width: 640px)" type="image/webp" />
        <source srcset="/assets/hero-mobile.jpg" media="(max-width: 640px)" type="image/jpeg" />

        <!-- Desktop -->
        <source srcset="/assets/hero.webp" type="image/webp" />
        <img
          src="/assets/hero.jpg"
          alt="Wedding decor at a Chennai venue"
          class="w-full h-full object-cover"
        />
      </picture>

      <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
        <h1 class="text-3xl md:text-5xl font-bold text-white text-center drop-shadow-lg">
          Premium Event Management in Chennai
        </h1>
      </div>
    </section>

    <!-- ABOUT SECTION -->
    <section class="max-w-5xl mx-auto px-5 py-12 md:py-16">
      <h2 class="text-3xl font-bold text-center mb-4 text-gray-900">About Us</h2>
      <p class="text-lg text-gray-700 text-center max-w-3xl mx-auto">
        Gabriel JM Events is your one-stop solution for weddings, receptions,
        corporate events, parties, photography, catering, décor, and full wedding planning
        across Chennai & Tamil Nadu. We make your event unforgettable with elegant, modern,
        and traditional event designs.
      </p>
    </section>

    <!-- SERVICES SECTION -->
    <section class="bg-gray-50 py-12 md:py-16">
      <div class="max-w-6xl mx-auto px-5">
        <h2 class="text-3xl font-bold text-center mb-10">Our Services</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="p-6 bg-white rounded-xl shadow">
            <h3 class="font-bold text-xl mb-2">Wedding Planning</h3>
            <p class="text-gray-600">Complete end-to-end wedding stage décor, mandap setup, bridal makeup, and venue decorations.</p>
          </div>

          <div class="p-6 bg-white rounded-xl shadow">
            <h3 class="font-bold text-xl mb-2">Corporate Events</h3>
            <p class="text-gray-600">Professional conference staging, product launch setups, LED backdrops, and event coordination.</p>
          </div>

          <div class="p-6 bg-white rounded-xl shadow">
            <h3 class="font-bold text-xl mb-2">Parties & Celebrations</h3>
            <p class="text-gray-600">Birthdays, baby showers, anniversaries with premium themes & balloon décor.</p>
          </div>

          <div class="p-6 bg-white rounded-xl shadow">
            <h3 class="font-bold text-xl mb-2">Photography & Videography</h3>
            <p class="text-gray-600">Candid and cinematic shoots for all events.</p>
          </div>

          <div class="p-6 bg-white rounded-xl shadow">
            <h3 class="font-bold text-xl mb-2">Catering Services</h3>
            <p class="text-gray-600">Delicious multi-cuisine catering with live counters.</p>
          </div>

          <div class="p-6 bg-white rounded-xl shadow">
            <h3 class="font-bold text-xl mb-2">Venue Arrangements</h3>
            <p class="text-gray-600">Venue booking, stage setup, lighting, flooring & sound systems.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PORTFOLIO SECTION -->
    <section class="max-w-6xl mx-auto px-5 py-12 md:py-16">
      <h2 class="text-3xl font-bold text-center mb-10">Our Portfolio</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Wedding 1 -->
        <div class="rounded-xl overflow-hidden shadow">
          <picture>
            <source srcset="/assets/wedding1.webp" type="image/webp" />
            <img src="/assets/wedding1.jpg" alt="Traditional wedding mandap décor" class="w-full h-56 object-cover" />
          </picture>
        </div>

        <!-- Wedding 2 -->
        <div class="rounded-xl overflow-hidden shadow">
          <img src="/assets/wedding2.jpg" alt="Elegant floral wedding stage" class="w-full h-56 object-cover" />
        </div>

        <!-- Corporate -->
        <div class="rounded-xl overflow-hidden shadow">
          <picture>
            <source srcset="/assets/corporate1.webp" type="image/webp" />
            <img src="/assets/corporate1.jpg" alt="Corporate conference event setup" class="w-full h-56 object-cover" />
          </picture>
        </div>

        <!-- Party -->
        <div class="rounded-xl overflow-hidden shadow">
          <picture>
            <source srcset="/assets/party1.webp" type="image/webp" />
            <img src="/assets/party1.jpg" alt="Party celebration venue with lighting and décor" class="w-full h-56 object-cover" />
          </picture>
        </div>

        <!-- Venue 1 -->
        <div class="rounded-xl overflow-hidden shadow">
          <picture>
            <source srcset="/assets/venue1.webp" type="image/webp" />
            <img src="/assets/venue1.jpg" alt="Chennai indoor event venue" class="w-full h-56 object-cover" />
          </picture>
        </div>

        <!-- Venue 2 -->
        <div class="rounded-xl overflow-hidden shadow">
          <picture>
            <source srcset="/assets/venue2.webp" type="image/webp" />
            <img src="/assets/venue2.jpg" alt="Outdoor event venue with lighting" class="w-full h-56 object-cover" />
          </picture>
        </div>

      </div>
    </section>

    <!-- CONTACT SECTION -->
    <section class="bg-gray-900 text-white py-12 md:py-16">
      <div class="max-w-5xl mx-auto px-5 text-center">
        <h2 class="text-3xl font-bold mb-4">Contact Us</h2>

        <p class="text-lg">Gabriel JM Event Management</p>
        <p class="mt-2">📞 +91 95661 44155</p>
        <p>📍 No. 14/5, Hindu Colony, 2nd Main Road, Puzhuthivakkam, Chennai – 600091</p>
        <p class="mt-2">✉️ gabrieljmcaterers@gmail.com</p>
      </div>
    </section>

    <!-- Footer -->
    <Footer />

  </body>
</html>
