---
// header component
---
<header class="hero">
  <img class="hero-img" src="/assets/hero.jpg" alt="Wedding decor in Chennai" loading="lazy" />
  <div class="hero-content container">
    <img src="/assets/logo.png" alt="Gabriel JM Events" class="mx-auto w-20 h-20 rounded-lg bg-white/10 p-2 mb-4" />
    <h1 class="text-3xl md:text-4xl font-semibold">Gabriel JM Events</h1>
    <p class="mt-2 text-lg text-white/90">Memorable weddings, corporate events & private celebrations — Chennai</p>
    <div class="mt-6 flex gap-3 justify-center">
      <a href="#contact" class="px-5 py-3 rounded-lg bg-[var(--accent)] text-white font-medium">Enquire Now</a>
      <a href="#portfolio" class="px-5 py-3 rounded-lg bg-white/20 text-white font-medium">View Portfolio</a>
    </div>
  </div>
</header>
