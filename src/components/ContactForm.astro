---
// src/components/ContactForm.astro
---
<section class="space-y-4 bg-white p-6 rounded-2xl shadow">
  <h3 class="text-xl font-semibold">Contact Gabriel JM Events</h3>
  <p class="text-gray-600">We'd love to hear about your event. Reach out via phone, WhatsApp or email — or visit our office in Chennai.</p>

  <div class="mt-4 grid gap-3">
    <div>
      <strong>Phone / WhatsApp</strong><br />
      <a href="tel:+91-XXXXXXXXXX" class="text-[var(--accent)]">+91-XXXXXXXXXX</a>
    </div>

    <div>
      <strong>Email</strong><br />
      <a href="mailto:info@gabrieljmevents.com" class="text-[var(--accent)]">info@gabrieljmevents.com</a>
    </div>

    <div>
      <strong>Office</strong><br />
      Gabriel JM Events<br />
      Chennai, Tamil Nadu, India
    </div>

    <div>
      <strong>Business hours</strong><br />
      Mon – Sat: 09:00 — 18:00
    </div>

    <div class="text-sm text-gray-500">
      <em>Prefer us to call you? Send a WhatsApp message to the number above with your event date and a short note — we'll reply within 24 hours.</em>
    </div>
  </div>
</section>
